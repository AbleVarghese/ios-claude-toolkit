#!/usr/bin/env bash
#
# pre-commit hook for iOS/Swift projects
#
# Checks:
#   1. Secrets scan (API keys, tokens, passwords in staged files)
#   2. SwiftLint (if Swift files are staged)
#   3. Sensitive files (blocks .env, credentials, secret configs)
#   4. Merge conflict markers
#   5. Large files (>5MB warning)
#
# Install:
#   cp pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -euo pipefail

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

ERRORS=0

# --- 1. Secrets scan ---
echo "Checking for secrets..."
SECRET_PATTERNS='(AKIA[0-9A-Z]{16}|sk_live_[a-zA-Z0-9]{24,}|sk_test_[a-zA-Z0-9]{24,}|ghp_[a-zA-Z0-9]{36}|xox[bpras]-[a-zA-Z0-9-]{10,}|-----BEGIN (RSA |EC )?PRIVATE KEY-----|password\s*=\s*["\x27][^"\x27]{8,}|api[_-]?key\s*[:=]\s*["\x27][a-zA-Z0-9]{16,}|secret[_-]?key\s*[:=]\s*["\x27][a-zA-Z0-9]{16,}|token\s*[:=]\s*["\x27][a-zA-Z0-9]{20,})'

for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        if git diff --cached "$file" | grep -iEq "$SECRET_PATTERNS"; then
            echo "  BLOCKED: Potential secret detected in $file"
            ERRORS=1
        fi
    fi
done

# --- 2. SwiftLint ---
SWIFT_FILES=$(echo "$STAGED_FILES" | grep '\.swift$' || true)
if [ -n "$SWIFT_FILES" ]; then
    if command -v swiftlint &>/dev/null; then
        echo "Running SwiftLint..."
        echo "$SWIFT_FILES" | xargs swiftlint lint --strict --quiet 2>/dev/null || {
            echo "  SwiftLint found violations."
            ERRORS=1
        }
    else
        echo "  SwiftLint not installed, skipping lint check."
    fi
fi

# --- 3. Sensitive files ---
echo "Checking for sensitive files..."
SENSITIVE_PATTERNS='(\.env$|\.env\.|Secrets\.xcconfig$|credentials\.json|service-account.*\.json|\.p12$|\.pem$|\.key$|\.keystore$|GoogleService-Info\.plist$)'

for file in $STAGED_FILES; do
    if echo "$file" | grep -Eq "$SENSITIVE_PATTERNS"; then
        echo "  BLOCKED: Sensitive file staged: $file"
        echo "           Add to .gitignore if this should never be committed."
        ERRORS=1
    fi
done

# --- 4. Merge conflict markers ---
echo "Checking for merge conflict markers..."
for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        if grep -rn '^<<<<<<< \|^=======$\|^>>>>>>> ' "$file" >/dev/null 2>&1; then
            echo "  BLOCKED: Merge conflict markers found in $file"
            ERRORS=1
        fi
    fi
done

# --- 5. Large files ---
echo "Checking for large files..."
for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        FILE_SIZE=$(wc -c < "$file" | tr -d ' ')
        if [ "$FILE_SIZE" -gt 5242880 ]; then
            SIZE_MB=$((FILE_SIZE / 1048576))
            echo "  WARNING: $file is ${SIZE_MB}MB (>5MB). Consider using Git LFS."
        fi
    fi
done

# --- Result ---
if [ "$ERRORS" -ne 0 ]; then
    echo ""
    echo "Pre-commit checks FAILED. Fix the issues above or bypass with: git commit --no-verify"
    exit 1
fi

echo "Pre-commit checks passed."
exit 0
